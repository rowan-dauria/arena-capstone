# API keys (OpenRouter alone can cover every role: use openrouter/<provider>/<model> ids)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model per role (decision D6). Use provider/model ids as Inspect expects.
# The judge must be from a different model family than the target.
AUDITOR_MODEL=
TARGET_MODEL=
PEER_MODEL=
JUDGE_MODEL=
REALISM_MODEL=

# Dev runs: a cheap model for auditor/peer/judge, and a cheap target whose
# chain of thought is visible in transcripts (e.g. openrouter/z-ai/glm-5.3-flash).
# Keep them from different families (judge != target family).
DEV_MODEL=
DEV_TARGET_MODEL=
# Dev peer (writes the misaligned agents' messages): must stay in persona. Check a
# candidate with scripts/check_peer.py first; Claude/GPT/Mistral models argued
# against or refused their goal there (e.g. openrouter/google/gemini-3.8-flash works).
# Not the target's family (D4).
DEV_PEER_MODEL=
# Dev judge (also runs the scanners and the drift judge): strong enough to fill
# Petri's structured judge answer every time. openrouter/anthropic/claude-haiku-5.5
# matched Sonnet on the scenario 3 dev transcripts and the drift fixtures (2026-11-03,
# scripts/rescore_judge.py) at ~1/20 the cost; the pilot keeps Sonnet. Not the
# target's family.
DEV_JUDGE_MODEL=
