# API keys (OpenRouter alone can cover every role: use openrouter/<provider>/<model> ids)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model per role (decision D6). Use provider/model ids as Inspect expects.
# The judge must be from a different model family than the target.
AUDITOR_MODEL=
TARGET_MODEL=
PEER_MODEL=
JUDGE_MODEL=
REALISM_MODEL=

# Dev runs: a cheap model for auditor/peer/judge, and a cheap target whose
# chain of thought is visible in transcripts (e.g. openrouter/z-ai/glm-5.3-flash).
# Keep them from different families (judge != target family).
DEV_MODEL=
DEV_TARGET_MODEL=
